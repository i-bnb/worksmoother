              { "key": "type", "type": "string", "size": 64, "required": true },
              { "key": "message", "type": "string", "size": 1000, "required": true },
              { "key": "dispatchedAt", "type": "string", "size": 64, "required": true },
              { "key": "status", "type": "string", "size": 32, "required": true }
            ]
          },
          {
            "id": "HOSPITAL",
            "name": "Hospital Directory",
            "attributes": [
              { "key": "name", "type": "string", "size": 255, "required": true },
              { "key": "address", "type": "string", "size": 500, "required": true },
              { "key": "phone", "type": "string", "size": 32, "required": true },
              { "key": "timezone", "type": "string", "size": 64, "required": true }
            ]
          },
          {
            "id": "DEPARTMENT",
            "name": "Hospital Departments",
