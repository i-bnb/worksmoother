{
  "projectA": {
    "name": "DoctorCare Operational Data",
    "projectId": "doctorcare-operational-prod",
    "description": "Operational workloads: appointments, clinic scheduling, staff directory, and notifications audit trail.",
    "databases": [
      {
        "id": "operational_db",
        "name": "Operational Database",
        "collections": [
          {
            "id": "appointments",
            "name": "Appointments",
            "attributes": [
              { "key": "patientId", "type": "string", "size": 128, "required": true },
              { "key": "doctorId", "type": "string", "size": 128, "required": true },
              { "key": "clinicId", "type": "string", "size": 128, "required": true },
              { "key": "scheduledAt", "type": "string", "size": 64, "required": true },
              { "key": "status", "type": "string", "size": 32, "required": true },
              { "key": "notes", "type": "string", "size": 1000, "required": false }
            ]
          },
          {
            "id": "clinics",
            "name": "Clinics",
            "attributes": [
              { "key": "name", "type": "string", "size": 255, "required": true },
              { "key": "address", "type": "string", "size": 500, "required": true },
              { "key": "phone", "type": "string", "size": 32, "required": true },
              { "key": "timezone", "type": "string", "size": 64, "required": true }
            ]
          },
          {
            "id": "notifications_log",
            "name": "Notifications Log",
            "attributes": [
              { "key": "recipientId", "type": "string", "size": 128, "required": true },
              { "key": "type", "type": "string", "size": 64, "required": true },
              { "key": "message", "type": "string", "size": 1000, "required": true },
              { "key": "dispatchedAt", "type": "string", "size": 64, "required": true },
              { "key": "status", "type": "string", "size": 32, "required": true }
            ]
          },
          {
            "id": "HOSPITAL",
            "name": "Hospital Directory",
            "attributes": [
              { "key": "name", "type": "string", "size": 255, "required": true },
              { "key": "address", "type": "string", "size": 500, "required": true },
              { "key": "phone", "type": "string", "size": 32, "required": true },
              { "key": "timezone", "type": "string", "size": 64, "required": true }
            ]
          },
          {
            "id": "DEPARTMENT",
            "name": "Hospital Departments",
            "attributes": [
              { "key": "hospital_id", "type": "string", "size": 128, "required": true },
              { "key": "name", "type": "string", "size": 255, "required": true },
              { "key": "description", "type": "string", "size": 1000, "required": false }
            ]
          },
          {
            "id": "DOCTOR",
            "name": "Doctor Directory",
            "attributes": [
              { "key": "hospital_id", "type": "string", "size": 128, "required": true },
              { "key": "department_id", "type": "string", "size": 128, "required": true },
              { "key": "name", "type": "string", "size": 255, "required": true },
              { "key": "email", "type": "string", "size": 255, "required": true },
              { "key": "specialty", "type": "string", "size": 128, "required": true },
              { "key": "active", "type": "boolean", "required": true }
            ]
          },
          {
            "id": "ROOM",
            "name": "Room Directory",
            "attributes": [
              { "key": "hospital_id", "type": "string", "size": 128, "required": true },
              { "key": "department_id", "type": "string", "size": 128, "required": true },
              { "key": "room_number", "type": "string", "size": 64, "required": true },
              { "key": "floor", "type": "integer", "required": true },
              { "key": "status", "type": "string", "size": 32, "required": true }
            ]
          },
          {
            "id": "AVAILABILITY_SLOT",
            "name": "Doctor Availability Slots",
            "attributes": [
              { "key": "slot_key", "type": "string", "size": 255, "required": true },
              { "key": "doctor_id", "type": "string", "size": 128, "required": true },
              { "key": "start_time_utc", "type": "string", "size": 64, "required": true },
              { "key": "end_time_utc", "type": "string", "size": 64, "required": true },
              { "key": "status", "type": "string", "size": 32, "required": true },
              { "key": "hold_expires_at", "type": "string", "size": 64, "required": false },
              { "key": "room_id", "type": "string", "size": 128, "required": false }
            ],
            "indexes": [
              { "key": "idx_slot_key_unique", "type": "unique", "attributes": ["slot_key"] }
            ]
          },
          {
            "id": "BOOKING",
            "name": "Patient Bookings",
            "attributes": [
              { "key": "booking_id", "type": "string", "size": 128, "required": true },
              { "key": "slot_key", "type": "string", "size": 255, "required": true },
              { "key": "doctor_id", "type": "string", "size": 128, "required": true },
              { "key": "patient_id", "type": "string", "size": 128, "required": true },
              { "key": "status", "type": "string", "size": 32, "required": true },
              { "key": "idempotency_key", "type": "string", "size": 128, "required": true },
              { "key": "hold_expires_at", "type": "string", "size": 64, "required": true },
              { "key": "created_at", "type": "string", "size": 64, "required": true }
            ],
            "indexes": [
              { "key": "idx_idempotency_key_unique", "type": "unique", "attributes": ["idempotency_key"] }
            ]
          }
        ]
      }
    ],
    "scopedApiKey": {
      "name": "key-project-a-operational",
      "scopes": [
        "databases.read",
        "databases.write",
        "collections.read",
        "collections.write",
        "documents.read",
        "documents.write",
        "users.read"
      ]
    },
    "authSecurity": {
      "passwordPolicy": {
        "hashingAlgorithm": "argon2",
        "passwordDictionary": true,
        "personalDataCheck": true,
        "minLength": 10
      },
      "emailSecurity": {
        "blockDisposableEmails": true,
        "disposableEmailBlocklist": [
          "mailinator.com",
          "guerrillamail.com",
          "tempmail.com",
          "10minutemail.com",
          "throwawaymail.com",
          "trashmail.com",
          "yopmail.com",
          "sharklasers.com",
          "dispostable.com"
        ]
      },
      "mfa": {
        "enabled": true,
        "enforceForRoles": ["admin", "staff", "doctor", "nurse"],
        "supportedFactors": ["totp", "email", "phone"]
      }
    }
  },
  "projectB": {
    "name": "DoctorCare Medical Records",
    "projectId": "doctorcare-medical-records-prod",
    "description": "Strictly isolated Protected Health Information (PHI) and Electronic Health Records (EHR) encrypted under KEK kek-2026-09.",
    "databases": [
      {
        "id": "medical_records_db",
        "name": "Medical Records & PHI Database",
        "collections": [
          {
            "id": "patient_charts",
            "name": "Patient Charts & Encounters",
            "attributes": [
              { "key": "patientId", "type": "string", "size": 128, "required": true },
              { "key": "doctorId", "type": "string", "size": 128, "required": true },
              { "key": "encounterDate", "type": "string", "size": 64, "required": true },
              { "key": "encryptedPayload", "type": "string", "size": 65535, "required": true },
              { "key": "kekId", "type": "string", "size": 64, "required": true },
              { "key": "createdAt", "type": "string", "size": 64, "required": true }
            ]
          }
        ]
      }
    ],
    "scopedApiKey": {
      "name": "key-project-b-medical-records-phi",
      "scopes": [
        "databases.read",
        "databases.write",
        "collections.read",
        "collections.write",
        "documents.read",
        "documents.write",
        "files.read",
        "files.write"
      ]
    }
  }
}
