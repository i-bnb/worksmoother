              { "key": "department_id", "type": "string", "size": 128, "required": true },
              { "key": "name", "type": "string", "size": 255, "required": true },
              { "key": "email", "type": "string", "size": 255, "required": true },
              { "key": "specialty", "type": "string", "size": 128, "required": true },
              { "key": "active", "type": "boolean", "required": true }
            ]
          },
          {
            "id": "ROOM",
            "name": "Room Directory",
            "attributes": [
              { "key": "hospital_id", "type": "string", "size": 128, "required": true },
              { "key": "department_id", "type": "string", "size": 128, "required": true },
              { "key": "room_number", "type": "string", "size": 64, "required": true },
              { "key": "floor", "type": "integer", "required": true },
              { "key": "status", "type": "string", "size": 32, "required": true }
