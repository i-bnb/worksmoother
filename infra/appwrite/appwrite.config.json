              { "key": "processed_at", "type": "string", "size": 64, "required": true },
              { "key": "status", "type": "string", "size": 32, "required": true }
            ],
            "indexes": [
              { "key": "idx_event_id_unique", "type": "unique", "attributes": ["event_id"] }
            ]
          },
          {
            "id": "CONSENT_LOG",
            "name": "DPDP Patient Consent Audit Trail",
            "attributes": [
              { "key": "consent_id", "type": "string", "size": 128, "required": true },
              { "key": "patient_id", "type": "string", "size": 128, "required": true },
              { "key": "purpose", "type": "string", "size": 128, "required": true },
              { "key": "notice_version", "type": "string", "size": 64, "required": true },
              { "key": "language", "type": "string", "size": 32, "required": true },
              { "key": "granted_at", "type": "string", "size": 64, "required": true },
