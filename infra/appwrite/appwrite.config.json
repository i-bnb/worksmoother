              { "key": "end_time_utc", "type": "string", "size": 64, "required": true },
              { "key": "status", "type": "string", "size": 32, "required": true },
              { "key": "hold_expires_at", "type": "string", "size": 64, "required": false },
              { "key": "room_id", "type": "string", "size": 128, "required": false }
            ],
            "indexes": [
              { "key": "idx_slot_key_unique", "type": "unique", "attributes": ["slot_key"] }
            ]
          },
          {
            "id": "BOOKING",
            "name": "Patient Bookings",
            "attributes": [
