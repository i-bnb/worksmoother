# ==============================================================================
# DoctorCare – Next.js Frontend Environment Variables
# Copy this file to .env.local and fill in the actual values.
# .env.local is gitignored and never committed.
# ==============================================================================

# ---------------------------------------------------------------------------
# Appwrite Cloud — Project A (Operational: Auth, Directory, Bookings)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_A_ID=doctorcare-operational-prod

# Server-only API key scoped to Project A (databases, documents, users, messages)
# Used exclusively in edge route handlers and SSR — never exposed to the browser.
APPWRITE_PROJECT_A_API_KEY=your_project_a_server_api_key_here

# ---------------------------------------------------------------------------
# Appwrite Cloud — Project B (Isolated: Medical Records / PHI)
# ---------------------------------------------------------------------------
# Project B ID is server-only; never exposed via NEXT_PUBLIC_* prefix.
APPWRITE_PROJECT_B_ID=doctorcare-medical-records-prod

# Server-only API key scoped to Project B (databases, documents, files)
# Strictly confined to the records Worker service binding — not the web app.
APPWRITE_PROJECT_B_API_KEY=your_project_b_server_api_key_here

# ---------------------------------------------------------------------------
# Cloudflare Worker API Gateway
# ---------------------------------------------------------------------------
# The public-facing URL of the doctorcare-api Worker.
# In local dev this falls back to http://127.0.0.1:8787 automatically.
NEXT_PUBLIC_API_URL=https://api.yourhospital.com

# ---------------------------------------------------------------------------
# Application Metadata
# ---------------------------------------------------------------------------
NODE_ENV=development
