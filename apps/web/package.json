{
  "name": "@doctorcare/web",
  "version": "1.0.0",
  "private": true,
  "description": "DoctorCare Healthcare Platform - Next.js Frontend on Cloudflare Workers via @opennextjs/cloudflare",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "start": "next start",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "setup:db": "npx tsx scripts/setup-appwrite-db.ts",
    "check:connectivity": "npx tsx scripts/check-appwrite-connectivity.ts"
  },
  "dependencies": {
    "@doctorcare/shared": "*",
    "@opennextjs/cloudflare": "~1.15.1",
    "appwrite": "^27.0.0",
    "dotenv": "^16.6.1",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "node-appwrite": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "wrangler": "^4.134.0"
  }
}
