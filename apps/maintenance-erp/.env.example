# ==============================================================================
# Maintenance Management ERP — Environment Variable Template (Phase 0)
# ==============================================================================
# Copy this file to .env before running seeds or tests.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Project Credentials (Required)
# ------------------------------------------------------------------------------
# For local development with Supabase CLI (supabase start):
#   SUPABASE_URL=http://127.0.0.1:54321
# For Supabase Cloud:
#   SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321

# Public anonymous key (Safe for browser / client-side)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key

# Service role key (STRICTLY SERVER-SIDE / CI / ADMIN SEEDING ONLY)
# NEVER expose this key to client-side code or browser bundles.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key

# ------------------------------------------------------------------------------
# 2. Local / Development Seed Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
# Password used for provisioning test staff/customer accounts in seed.ts
SEED_USER_PASSWORD=DevPassword123!

# ------------------------------------------------------------------------------
# 3. Future External Integrations (Phase 1+ / Edge Functions)
# ------------------------------------------------------------------------------
# Google Gemini API (Strictly Server-Side within Edge Functions)
# Note: Specific model IDs are dynamically loaded from public.settings
GEMINI_API_KEY=

# WhatsApp Business Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Transactional Email (Resend / SendGrid / SMTP)
RESEND_API_KEY=
EMAIL_FROM=support@apexfacilities.com
